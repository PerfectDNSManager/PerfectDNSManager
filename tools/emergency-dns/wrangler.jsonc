{
  "name": "pdm-dns-standby",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": { "ENABLED": "false", "UPSTREAM": "https://one.one.one.one/dns-query", "RULES_JSON": "[]" },
  "ratelimits": [{ "name": "DNS_LIMITER", "namespace_id": "18001", "simple": { "limit": 100, "period": 10 } }]
}
