<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/pdm_background" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/btnBack" style="@style/PDMBackButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back_arrow"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/support_us_title" android:textColor="@color/pdm_accent_gold" android:textSize="20sp"
            android:paddingStart="16dp" android:paddingEnd="8dp"/>
        <ImageButton android:id="@+id/supportPageQr" android:layout_width="96dp" android:layout_height="96dp"
            android:scaleType="fitCenter" android:padding="0dp" android:background="@android:color/white"
            android:contentDescription="@string/support_qr_content_description"/>
    </LinearLayout>
    <TextView android:id="@+id/supportPageUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/pdm_text_secondary" android:textSize="12sp" android:padding="8dp"/>
    <FrameLayout android:id="@+id/supportWebContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
